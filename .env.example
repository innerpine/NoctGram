# Copy to .env for local vinext development. Never commit .env.
# Keep hybrid while existing users link their email from Edit profile.
NOCT_AUTH_MODE=hybrid
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Music account connections. See MUSIC_SERVICES_SETUP.md.
# Generate MUSIC_TOKEN_KEY as 32 random bytes encoded as 64 hex characters.
MUSIC_TOKEN_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/music/services/soundcloud/callback
# Spotify uses PKCE. Its local redirect must use a loopback IP, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/music/services/spotify/callback
