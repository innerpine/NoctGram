# Copy to .env for local vinext development. Never commit .env.
# Keep hybrid while existing users link their email from Edit profile.
NOCT_AUTH_MODE=hybrid
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# npm run setup:realtime generates VAPID and job secrets in local .env.
NOCT_VAPID_PUBLIC_KEY=
NOCT_VAPID_PRIVATE_KEY=
NOCT_VAPID_SUBJECT=https://github.com/innerpine/NoctGram
NOCT_JOBS_SECRET=
# Optional coturn REST credentials for calls across restrictive networks.
NOCT_STUN_URLS=stun:stun.l.google.com:19302
NOCT_TURN_URLS=
NOCT_TURN_SECRET=

# Local testing only. Leave disabled on a public instance.
NOCT_PREMIUM_TEST_MODE=0

# Local Telegram test top-ups; populated by npm run setup:bot.
# Keep disabled on public instances. Never put TELEGRAM_BOT_TOKEN here.
NOCT_BOT_TEST_MODE=0
NOCT_BOT_USERNAME=
NOCT_BOT_SECRET=
