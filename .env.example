# Copy to .env for local vinext development. Never commit .env.
# Keep hybrid while existing users link their email from Edit profile.
NOCT_AUTH_MODE=hybrid
# Public deployment: set BOTH NOCT_DEPLOYMENT_TARGET=standalone and NOCT_AUTH_MODE=email.
# Leave this empty only for local development or the managed Sites/Access environment.
NOCT_DEPLOYMENT_TARGET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Music account connections. See MUSIC_SERVICES_SETUP.md.
# Generate MUSIC_TOKEN_KEY as 32 random bytes encoded as 64 hex characters.
MUSIC_TOKEN_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/music/services/soundcloud/callback
# Spotify uses PKCE. Its local redirect must use a loopback IP, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/music/services/spotify/callback

# npm run setup:realtime generates VAPID and job secrets in local .env.
NOCT_VAPID_PUBLIC_KEY=
NOCT_VAPID_PRIVATE_KEY=
NOCT_VAPID_SUBJECT=https://github.com/innerpine/NoctGram
NOCT_JOBS_SECRET=
# Calls: see TURN_SETUP.md. All TURN keys below are SERVER-ONLY.
NOCT_STUN_URLS=stun:stun.cloudflare.com:3478
NOCT_TURN_PROVIDER=cloudflare
NOCT_CF_TURN_KEY_ID=
NOCT_CF_TURN_API_TOKEN=
# Optional self-hosted alternative: NOCT_TURN_PROVIDER=coturn.
NOCT_TURN_URLS=
NOCT_TURN_SECRET=

# Local testing only. Leave disabled on a public instance.
NOCT_PREMIUM_TEST_MODE=0
NOCT_STARS_TEST_MODE=0

# Telegram bridge. TEST_MODE controls only free top-ups, not paid purchases.
# Never put TELEGRAM_BOT_TOKEN here.
NOCT_BOT_TEST_MODE=0
NOCT_BOT_USERNAME=
NOCT_BOT_SECRET=
# Crypto Pay token stays on the server. Standard independent website checkout.
CRYPTO_PAY_API_TOKEN=
