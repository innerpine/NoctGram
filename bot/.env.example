# Copy to bot/.env. This file is ignored by Git. The website never gets this token.
TELEGRAM_BOT_TOKEN=
NOCT_SITE_URL=http://localhost:3000
NOCT_BOT_TEST_MODE=0
# Generated by npm run setup:bot and shared with the website .env.
NOCT_BOT_SECRET=
# Try custom emoji by default, with ordinary fallbacks if Telegram denies them.
NOCT_BOT_CUSTOM_EMOJI=1
# Public webhook deployment only; see bot/CLOUDFLARE.md.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
