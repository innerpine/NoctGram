# Copy to bot/.env. This file is ignored by Git. The website never gets this token.
TELEGRAM_BOT_TOKEN=
NOCT_SITE_URL=http://localhost:3000
NOCT_BOT_TEST_MODE=1
# Generated by npm run setup:bot and shared with the website .env.
NOCT_BOT_SECRET=
# Enable only if this bot can use custom emoji (see bot/README.md).
NOCT_BOT_CUSTOM_EMOJI=0
